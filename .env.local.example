# URL aplikasi frontend (dipakai middleware/redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL backend Laravel (server-only, tidak pernah ke browser).
# Development lokal:  http://localhost:8000/api/v1
# Produksi (satu VPS): http://127.0.0.1:8081/api/v1  (entrypoint internal nginx)
PAYMENT_API_BASE_URL=http://localhost:8000/api/v1

# Secret untuk iron-session — WAJIB minimal 32 karakter, ganti dengan random string
SESSION_SECRET=change-me-to-a-long-random-secret-32-chars
